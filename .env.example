### App password (simplest) ###
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_MAIL=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here
# Optional. Display name shown in the recipient's inbox next to the sender.
SMTP_FROM_NAME=Shop Management
# Optional. Where replies to activation mails should go. Defaults to SMTP_MAIL.
# SMTP_REPLY_TO=support@example.com

### OR: OAuth2 (recommended for production) ###
# Set SMTP_AUTH_METHOD=oauth2 to use OAuth2 flow
SMTP_AUTH_METHOD=oauth2
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token

# Test target
TEST_TO=recipient@example.com

# Stripe
# Secret key from the Stripe dashboard (starts with sk_test_ or rkcs_test_).
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Publishable key served to the browser via /api/v2/payment/stripeapikey
# (starts with pk_test_ or pk_live_). Never put your secret key in the frontend.
STRIPE_API_KEY=pk_test_your_publishable_key
